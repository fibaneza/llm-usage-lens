# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out
# Auto-generated by Next.js; regenerated on dev/build, never committed.
next-env.d.ts

# Nuxt.js build / generate output
.nuxt
dist
.output

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp directory
.temp

# Sveltekit cache directory
.svelte-kit/

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Firebase cache directory
.firebase/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# pnpm
.pnpm-store

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# Claude Code — personal per-user overrides (shared settings.json IS committed)
.claude/settings.local.json

.DS_Store

# DevContainer secrets — local-only, never commit. Seeded from the tracked
# .example on first start (see devcontainer.json initializeCommand).
.devcontainer/grafana/grafana_admin_password.txt

# Bedrock simulator (tools/bedrock-simulator/) — independent of the dashboard
# pnpm workspace. Build/deploy artifacts and the sandbox-account config never
# leave the local machine or the GitHub Actions runner.
tools/bedrock-simulator/.aws-sam/
tools/bedrock-simulator/.bootstrap.env
tools/bedrock-simulator/samconfig.toml
tools/bedrock-simulator/samconfig.toml.management
tools/bedrock-simulator/samconfig.toml.sandbox
tools/bedrock-simulator/node_modules/
tools/bedrock-simulator/dist/
tools/bedrock-simulator/coverage/
.devcontainer/.env

# Playwright — headless E2E artifacts (screenshots, traces, HTML report)
test-results/
playwright-report/
playwright/.cache/

# Git directories
/worktrees
.claude/worktrees/

# Local scratch — design exports, screenshots, throwaway working files. Never
# pushed. Curated reference material is promoted into docs/ instead (e.g. the
# Strata design system lives at docs/design-system/).
/temp/

# CDK synth output
cdk.out/

# others
docs/todo.md
.next-probe-r5
.next-probe-litellm
.next-base-path

# Written by `next dev` (agentRules: false stops it; never committed)
apps/dashboard/AGENTS.md

# Built by `pnpm --filter @llm-usage-lens/dashboard run build:jobs` (unit SYNC2)
apps/dashboard/jobs/*.cjs
