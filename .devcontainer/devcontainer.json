{
  "name": "otel-dev",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace/aws-bedrock-cost-tracker",
  "remoteUser": "${localEnv:USER}",
  "updateRemoteUserUID": true,
  "forwardPorts": [
    3000, // Grafana
    4317, // OTLP gRPC
    4318, // OTLP HTTP
    8000, // Prometheus
    9090, // Alertmanager
    3001, // Tempo
    3100 // Loki
  ],
  "containerEnv": {
    // "TZ": "${localEnv:TZ}" // fails on macOS because macOS doesn't use the standard /etc/timezone file found on Linux.
    "TZ": "Australia/Melbourne"
  },
  // Runs on the host before container creation. Two jobs: (1) ensure every
  // bind-mount source below exists so the mount never fails (Docker would
  // otherwise create a missing source as a root-owned directory, or error
  // out); (2) seed the gitignored Grafana admin password from its tracked
  // .example on first start, so the stack comes up without manual setup.
  "initializeCommand": "[ -f .env ] || cp .env.example .env; mkdir -p \"$HOME/.ssh\" \"$HOME/.aws\" \"$HOME/.azure\"; f=.devcontainer/grafana/grafana_admin_password.txt; [ -f \"$f\" ] || cp \"$f.example\" \"$f\"",
  "features": {
    // The default node user (renamed to match the host user) already contains a lot of common utils, but for now skipping the common-utils feature to save time during image build.
    // "ghcr.io/devcontainers/features/common-utils:2": {
    //     "installZsh": "true",
    //     "installOhMyZsh": "true",
    //     "installOhMyZshConfig": "true",
    //     "username": "${localEnv:USER}",
    //     "upgradePackages": "true"
    // },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/jsburckhardt/devcontainer-features/uv:1": {}, // Python 3 + uv (provides `uvx`) for MCP servers shipped as Python tools.
    "ghcr.io/devcontainers/features/aws-cli:1": {},
    // "ghcr.io/devcontainers/features/azure-cli:1": {}, Too big ~3 GB - Only need for `az login` to populate the token cache, so bind-mounting the host config + cache dirs is sufficient (see mounts below).
    "ghcr.io/eitsupi/devcontainer-features/jq-likes:2": {
      "jqVersion": "latest",
      "yqVersion": "latest"
    }, // jq, yq, gojq, xq, jaq — various structured-data query tools used in scripts and debugging
    // "ghcr.io/devcontainer-community/devcontainer-features/yq:1": {}, // yq v4 for YAML processing in scripts (separate from the jq-likes version to get the latest)
    "ghcr.io/customink/codespaces-features/sam-cli:1": {},
    "ghcr.io/stu-bell/devcontainer-features/claude-code:0": {},
    "ghcr.io/shyim/devcontainers-features/bun:0": {} // required by the claude-mem plugin's stop hook (summarize script)
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "amazonwebservices.aws-toolkit-vscode", // Browse DynamoDB Local + Lambda collector work (Phase 6)
        "anthropic.claude-vscode", // Claude Code integration
        "bradlc.vscode-tailwindcss", // Tailwind CSS v4 class completion
        "davidanson.vscode-markdownlint", // Keep docs/specs/** consistently formatted
        "dbaeumer.vscode-eslint", // ESLint v9 flat-config diagnostics (Rule 40)
        "esbenp.prettier-vscode", // Format-on-save matching the Prettier gate
        "grafana.vscode-grafana", // Author/preview Grafana dashboards
        "github.vscode-github-actions", // Github Actions
        "ms-azuretools.vscode-docker", // Manage the compose stack from the editor
        "ms-playwright.playwright", // Run/debug the headless E2E suite (apps/dashboard/e2e)
        "redhat.vscode-yaml", // Validate docker-compose + otel-collector-config.yaml
        "usernamehw.errorlens", // Inline diagnostics — pairs with pretty-ts-errors under strict mode
        "vitest.explorer", // Run/debug Vitest tests in the editor (not Jest)
        "vivaxy.vscode-conventional-commits", // Guided Conventional Commit messages (commitlint gate)
        "vscode-icons-team.vscode-icons", // File icon theme; activated via workbench.iconTheme below
        "vstirbu.vscode-mermaid-preview", // Preview Mermaid diagrams (used in docs/specs) directly in VS Code
        "yoavbls.pretty-ts-errors" // Readable errors for TypeScript strict mode,
      ]
      // Editor settings live in .vscode/settings.json — workspace settings
      // apply inside the container too (and take precedence over anything set
      // here), so they are kept in one place. This file keeps only container
      // concerns: extension auto-install (mirror of .vscode/extensions.json),
      // features, mounts, ports, lifecycle commands.
    }
  },
  "mounts": [
    // "source=${localWorkspaceFolder},target=/workspace/${localEnv:COMPOSE_PROJECT_NAME},type=bind,consistency=cached",
    "source=${localEnv:HOME}/.ssh,target=/home/${localEnv:USER}/.ssh,type=bind,consistency=cached",
    // Share AWS SSO cache + config so `aws sso login` on the host is usable
    // from inside the container (per Rule 50 — no static AWS keys).
    "source=${localEnv:HOME}/.aws,target=/home/${localEnv:USER}/.aws,type=bind,consistency=cached",
    // Share Azure CLI config + token cache so `az login` on the host is usable
    // from inside the container.
    "source=${localEnv:HOME}/.azure,target=/home/${localEnv:USER}/.azure,type=bind,consistency=cached"
  ],
  "postCreateCommand": "bash .devcontainer/post-create.sh"
}