# Example env for devcontainer (committed, non-secret)
# Copy to .devcontainer/.env and fill with real values locally (do not commit)

# Next.js / app
NODE_ENV=development

# OpenTelemetry collector endpoint (container-local hostname)
OTEL_DEFAULT_ENDPOINT=http://otel-collector:4317

# AWS profile to use via SSO (do not put static keys here)
AWS_PROFILE=your-sso-profile