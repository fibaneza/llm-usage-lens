{
  "name": "bedrock-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Bedrock test harness. Not part of the Bedrock Cost Dashboard pnpm workspace.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && esbuild src/handler.ts src/invocation-logging-config.ts --bundle --platform=node --target=node22 --format=esm --external:@aws-sdk/* --outdir=dist --out-extension:.js=.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sam:validate": "sam validate --lint",
    "sam:build": "sam build"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.10.5",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.726.1",
    "@aws-sdk/client-bedrock": "^3.726.1",
    "@aws-sdk/client-sts": "^3.726.1",
    "zod": "^3.24.1"
  }
}
