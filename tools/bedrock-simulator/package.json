{
  "name": "bedrock-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Bedrock test harness. Not part of the LLM Usage Lens pnpm workspace.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit && node build.mjs && sam build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sam:validate": "sam validate --lint",
    "sam:build": "sam build",
    "hooks:install": "cp .hooks/pre-push ../../.git/hooks/pre-push && chmod +x ../../.git/hooks/pre-push && echo 'pre-push hook installed — remove with pnpm hooks:uninstall when Phase 1 Husky is wired up'",
    "hooks:uninstall": "rm -f ../../.git/hooks/pre-push && echo 'pre-push hook removed'"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^25.9.3",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.7",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.1164.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1164.0",
    "@aws-sdk/client-sts": "^3.1164.0",
    "zod": "^4.6.7"
  }
}
