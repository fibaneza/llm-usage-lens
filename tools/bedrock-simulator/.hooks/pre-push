#!/usr/bin/env sh
# tools/bedrock-simulator/.hooks/pre-push
#
# Runs typecheck, unit tests, and a secret scan when simulator files are in
# the commits being pushed.  A no-op for pushes that touch other paths only.
#
# Install once (from tools/bedrock-simulator/):  pnpm hooks:install
# Remove (when Phase 1 Husky supersedes this):   pnpm hooks:uninstall
# See docs/guides/git-hooks.md for the full hooks strategy.

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
ZERO=$(git hash-object --stdin </dev/null | tr '[0-9a-f]' '0')
RANGES=""

while IFS=" " read -r local_ref local_oid remote_ref remote_oid; do
  [ "$local_oid" = "$ZERO" ] && continue
  if [ "$remote_oid" = "$ZERO" ]; then
    RANGES="$RANGES $local_oid"
  else
    RANGES="$RANGES $remote_oid..$local_oid"
  fi
done

[ -z "$RANGES" ] && exit 0

# Skip entirely when no simulator files are in the commits being pushed.
# shellcheck disable=SC2086
git diff --name-only $RANGES 2>/dev/null | grep -q "^tools/bedrock-simulator/" || exit 0

echo "→ bedrock-simulator: typecheck"
(cd "$REPO_ROOT/tools/bedrock-simulator" && pnpm typecheck)

echo "→ bedrock-simulator: tests"
(cd "$REPO_ROOT/tools/bedrock-simulator" && pnpm test)

# Dependency health — warn-only (network; offline just prints). Enforcement is
# the blocking audit in bedrock-simulator-build.yml.
SIM="$REPO_ROOT/tools/bedrock-simulator"

echo "→ bedrock-simulator: dependency freshness (warn-only)"
(cd "$SIM" && pnpm outdated) \
  || echo "  ⚠  Dependencies behind latest (table above). Non-blocking — 'pnpm up --latest' to refresh."

echo "→ bedrock-simulator: security audit (warn-only)"
(cd "$SIM" && pnpm audit) \
  || echo "  ⚠  Vulnerabilities found (above). Non-blocking — 'pnpm up <pkg>@latest', then re-run 'pnpm audit'."

echo "→ bedrock-simulator: duplicate versions (warn-only)"
(cd "$SIM" && pnpm dedupe --check) \
  || echo "  ⚠  Lockfile could be flattened. Non-blocking — run 'pnpm dedupe'."

# Real AWS account IDs must never be committed (Rule 50). Runs regardless of
# gitleaks because the default ruleset does not flag account IDs. We extract any
# 12-digit number that sits in an account-ID context — an account_id key, a
# SandboxAccountId param, or an arn's :NNNNNNNNNNNN: field — then drop the
# 000000000000 placeholder. Anything left is a real ID. We match the pattern,
# never a literal account ID.
echo "→ AWS account ID scan"
# shellcheck disable=SC2086
acct_hits=$(git diff $RANGES 2>/dev/null \
  | grep -E '^\+[^+]' \
  | grep -Eio '(account[_-]?id["=: ]*[0-9]{12}|sandboxaccountid["=: ]*[0-9]{12}|:[0-9]{12}:)' \
  | grep -Eo '[0-9]{12}' \
  | grep -Ev '^0{12}$' || true)
if [ -n "$acct_hits" ]; then
  echo "⛔  Possible real AWS account ID added in this push."
  echo "    Use the 000000000000 placeholder; real IDs belong only in gitignored"
  echo "    .bootstrap.env / samconfig.toml (Rule 50)."
  exit 1
fi

echo "→ secret scan"
if command -v gitleaks >/dev/null 2>&1; then
  # Scan each push range separately so new-branch pushes are handled correctly.
  # gitleaks auto-loads the repo-root .gitleaks.toml (aws-account-id rule).
  # shellcheck disable=SC2086
  for range in $RANGES; do
    (cd "$REPO_ROOT" && gitleaks git --no-banner --log-opts="$range")
  done
else
  echo "  ⚠  gitleaks not found — grep fallback active (install gitleaks for full coverage)"
  echo "     brew install gitleaks   |   https://github.com/gitleaks/gitleaks"
  # shellcheck disable=SC2086
  if git diff $RANGES -- "tools/bedrock-simulator/" \
      | grep -En 'AKIA[0-9A-Z]{16}|ASIA[0-9A-Z]{16}|-----BEGIN (RSA|EC|OPENSSH|DSA|PGP) PRIVATE KEY|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]\s*=\s*\S{8,}|[Ss][Ee][Cc][Rr][Ee][Tt]\s*[=:]\s*\S{8,}'; then
    echo "⛔  Possible secret detected in diff — review and remove before pushing."
    exit 1
  fi
fi

echo "→ all checks passed"
