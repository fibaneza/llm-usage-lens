# .bootstrap.env.example — copy to .bootstrap.env and fill in your sandbox values.
#
#   cp .bootstrap.env.example .bootstrap.env
#
# .bootstrap.env is gitignored. Do NOT commit it — it holds your real AWS
# account ID. bootstrap.sh sources this file (if present) for its defaults;
# CLI flags still override anything set here.
#
# This file is sourced by bash, so use KEY="value" with no spaces around "=".

# AWS SSO profile used to run the one-time bootstrap (overrides $AWS_PROFILE).
PROFILE="bedrock-simulator-sandbox"

# Sandbox AWS account ID (12 digits). REQUIRED.
# Leave the all-zeros placeholder and bootstrap.sh will refuse to run.
ACCOUNT_ID="000000000000"

# GitHub owner / username the OIDC deployer role trusts. REQUIRED.
GITHUB_OWNER="your-github-username"

# GitHub repository name (the deployer role's trust policy scopes to this repo).
GITHUB_REPO="llm-usage-lens"

# GitHub Environment bound to the simulator workflows.
GITHUB_ENV="bedrock-simulator-sandbox"

# Email for the AWS Budget alarm. Leave empty to be prompted interactively.
BUDGET_EMAIL=""

# "true" to encrypt invocation logs with a customer-managed KMS key (~$1/month).
# "false" uses SSE-S3 (AES256) — encrypted at rest, no CMK cost.
KMS_ENCRYPTION="false"

# CloudFormation stack name and region. Defaults are fine for most setups.
STACK_NAME="bedrock-simulator"
REGION="us-east-1"
