{
  "name": "llm-usage-lens",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --dir apps/dashboard exec next dev",
    "build": "pnpm --filter @llm-usage-lens/dashboard build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.scripts.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @llm-usage-lens/dashboard test:e2e",
    "build:ci": "NEXT_TELEMETRY_DISABLED=1 NEXT_PUBLIC_APP_URL=http://localhost:3000 AUTH_SECRET=ci-build-placeholder AUTH_MICROSOFT_ENTRA_ID_ID=ci-build-placeholder AUTH_MICROSOFT_ENTRA_ID_SECRET=ci-build-placeholder AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/v2.0 pnpm build",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && vitest run && pnpm build:ci",
    "prepare": "husky",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:create-table": "tsx scripts/create-table.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:empty": "tsx scripts/seed-empty.ts",
    "db:seed:large": "tsx scripts/seed-large.ts",
    "db:seed:ranking": "tsx scripts/seed-ranking.ts"
  },
  "lint-staged": {
    "apps/dashboard/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "apps/dashboard/**/*.{json,css,md}": [
      "prettier --write"
    ],
    "packages/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "infra/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "scripts/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1155.0",
    "@aws-sdk/lib-dynamodb": "^3.1155.0",
    "@llm-usage-lens/shared": "workspace:*",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.7",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tsx": "^4.23.15",
    "typescript": "^6",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  }
}
