{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudFormationStacks",
      "Effect": "Allow",
      "Action": "cloudformation:*",
      "Resource": [
        "arn:__PARTITION__:cloudformation:__REGION__:__ACCOUNT_ID__:stack/bedrock-simulator-sandbox/*",
        "arn:__PARTITION__:cloudformation:__REGION__:__ACCOUNT_ID__:stack/aws-sam-cli-managed-default/*"
      ]
    },
    {
      "Sid": "CloudFormationAccountLevel",
      "Effect": "Allow",
      "Action": [
        "cloudformation:ValidateTemplate",
        "cloudformation:GetTemplateSummary",
        "cloudformation:ListStacks",
        "cloudformation:ListExports",
        "cloudformation:ListImports",
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SamServerlessTransform",
      "Effect": "Allow",
      "Action": "cloudformation:CreateChangeSet",
      "Resource": "arn:__PARTITION__:cloudformation:__REGION__:aws:transform/Serverless-2016-10-31"
    },
    {
      "Sid": "SamArtifactBucket",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:__PARTITION__:s3:::aws-sam-cli-managed-default-*",
        "arn:__PARTITION__:s3:::aws-sam-cli-managed-default-*/*"
      ]
    },
    {
      "Sid": "InvokeSimulatorLambda",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:__PARTITION__:lambda:__REGION__:__ACCOUNT_ID__:function:bedrock-simulator"
    },
    {
      "Sid": "ReadStackResources",
      "Effect": "Allow",
      "Action": [
        "bedrock:GetInferenceProfile",
        "bedrock:GetGuardrail",
        "bedrock:GetModelInvocationLoggingConfiguration"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DestroyPreSteps",
      "Effect": "Allow",
      "Action": "bedrock:DeleteModelInvocationLoggingConfiguration",
      "Resource": "*"
    },
    {
      "Sid": "KmsKeyCleanup",
      "Effect": "Allow",
      "Action": ["kms:DescribeKey", "kms:DisableKey"],
      "Resource": "*"
    },
    {
      "Sid": "EmptyLoggingBucketDuringDestroy",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s3:ListBucketMultipartUploads",
        "s3:ListMultipartUploadParts",
        "s3:AbortMultipartUpload"
      ],
      "Resource": [
        "arn:__PARTITION__:s3:::bedrock-simulator-*",
        "arn:__PARTITION__:s3:::bedrock-simulator-*/*",
        "arn:__PARTITION__:s3:::*-invocation-logging-bucket/*",
        "arn:__PARTITION__:s3:::*-invocation-logging-bucket"
      ]
    }
  ]
}
