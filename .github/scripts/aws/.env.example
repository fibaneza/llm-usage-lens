# .env.example — copy to .env and fill in your sandbox values.
#
#   cp .github/scripts/aws/.env.example .github/scripts/aws/.env
#
# .env is gitignored. Do NOT commit it — it holds your real AWS account ID. The
# deployer-role wrapper (.github/scripts/aws/create-bedrock-simulator-deployer-role.sh)
# sources this file for all of its configuration; it takes no config flags.
#
# This file is sourced by bash, so use KEY="value" with no spaces around "=".

# AWS SSO profile used to run the wrapper (overrides $AWS_PROFILE).
PROFILE="bedrock-simulator-sandbox"

# Sandbox AWS account ID (12 digits). REQUIRED.
# Leave the all-zeros placeholder and the wrapper will refuse to run.
ACCOUNT_ID="000000000000"

# GitHub owner / username the OIDC deployer role trusts. REQUIRED.
GITHUB_OWNER="your-github-username"

# GitHub repository name (the deployer role's trust policy scopes to this repo).
GITHUB_REPO="aws-bedrock-cost-tracker"

# GitHub Environment bound to the simulator workflows.
GITHUB_ENV="bedrock-simulator-sandbox"

# AWS region for the OIDC trust / token substitution. Default is fine for most.
REGION="us-east-1"
