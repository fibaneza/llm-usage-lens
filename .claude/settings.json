{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_SERVICE_NAME": "bedrock-cost-dashboard",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
    "__OTEL_EXPORTER_OTLP_ENDPOINT__NOCONTAINER": "http://localhost:4317",
    "OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE": "cumulative",
    "OTEL_METRIC_EXPORT_INTERVAL": "10000"
  },
  "permissions": {
    "allow": [
      "Read(/Users/fernando.ibanez/projects/aws-bedrock-claude-cost-usage/**)",
      "Read(/workspace/aws-bedrock-cost-tracker/**)",
      "Edit(/workspace/aws-bedrock-cost-tracker/**)",
      "Grep",
      "Glob",
      "Write(/tmp/**)",
      "Write(/workspace/aws-bedrock-cost-tracker/**)",
      "Bash(pnpm *)",
      "Bash(docker compose up -d)",
      "Bash(docker compose up -d dynamodb-local)",
      "Bash(docker compose down)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs *)",
      "Bash(git *)",
      "Bash(aws sts get-caller-identity *)",
      "Bash(aws sso login *)",
      "Bash(aws cloudformation describe-* *)",
      "Bash(aws cloudformation list-* *)",
      "Bash(aws cloudformation validate-template *)",
      "Bash(aws iam list-* *)",
      "Bash(aws iam get-* *)",
      "Bash(aws bedrock list-* *)",
      "Bash(aws bedrock get-* *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find . *)",
      "Bash(find /workspace *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(where *)",
      "Bash(type *)",
      "Bash(env)",
      "Bash(printenv *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(wc *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(xargs *)",
      "Bash(tee *)",
      "Bash(diff *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(chmod *)",
      "Bash(date *)",
      "Bash(jq *)",
      "Bash(node *)",
      "Bash(npx *)",
      "Bash(gh *)",
      "Bash(sam build*)",
      "Bash(sam deploy*)",
      "Bash(sam local *)",
      "Bash(sam logs *)",
      "Bash(sam validate*)",
      "Bash(shellcheck *)",
      "Bash(curl *)",
      "Bash(ps *)",
      "Bash(kill *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(git commit --no-verify*)",
      "Bash(aws * delete-*)",
      "Bash(aws dynamodb delete-table*)",
      "Bash(aws cloudformation delete-stack*)",
      "Bash(sam delete*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/server-only-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/prettier-on-edit.sh"
          }
        ]
      }
    ]
  },
  "enableAllProjectMcpServers": true
}
