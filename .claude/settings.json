{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_SERVICE_NAME": "bedrock-cost-dashboard",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
    "__OTEL_EXPORTER_OTLP_ENDPOINT__NOCONTAINER": "http://localhost:4317",
    "OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE": "cumulative",
    "OTEL_METRIC_EXPORT_INTERVAL": "10000"
  },
  "permissions": {
    "allow": [
      "Read(/Users/fernando.ibanez/projects/aws-bedrock-claude-cost-usage/**)",
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm dev)",
      "Bash(pnpm build)",
      "Bash(pnpm exec tsc --noEmit)",
      "Bash(pnpm exec eslint .)",
      "Bash(pnpm exec eslint . --fix)",
      "Bash(pnpm exec prettier --check .)",
      "Bash(pnpm exec prettier --write .)",
      "Bash(pnpm exec vitest run)",
      "Bash(pnpm exec vitest run --coverage)",
      "Bash(pnpm exec playwright test)",
      "Bash(pnpm tsx scripts/*.ts)",
      "Bash(pnpm -r run lint)",
      "Bash(pnpm -r run typecheck)",
      "Bash(pnpm -r run test)",
      "Bash(docker compose up -d)",
      "Bash(docker compose up -d dynamodb-local)",
      "Bash(docker compose down)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs *)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git diff --cached)",
      "Bash(git diff --stat)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(aws sts get-caller-identity *)",
      "Bash(aws sso login *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(rg *)",
      "Bash(find . *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(git commit --no-verify*)",
      "Bash(aws * delete-*)",
      "Bash(aws dynamodb delete-table*)",
      "Bash(aws cloudformation delete-stack*)",
      "Bash(sam delete*)"
    ]
  },
  "enableAllProjectMcpServers": true
}
