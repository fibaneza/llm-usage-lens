{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_SERVICE_NAME": "llm-usage-lens",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
    "__OTEL_EXPORTER_OTLP_ENDPOINT__NOCONTAINER": "http://localhost:4317",
    "OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE": "cumulative",
    "OTEL_METRIC_EXPORT_INTERVAL": "10000"
  },
  "permissions": {
    "allow": [
      "Read(/**)",
      "Edit(/**)",
      "Read(//workspace/aws-bedrock-cost-tracker/**)",
      "Edit(//workspace/aws-bedrock-cost-tracker/**)",
      "Read(//tmp/**)",
      "Edit(//tmp/**)",
      "Grep",
      "Glob",
      "WebFetch(domain:docs.aws.amazon.com)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:zod.dev)",
      "WebFetch(domain:vitest.dev)",
      "WebFetch(domain:authjs.dev)",
      "WebFetch(domain:tanstack.com)",
      "WebFetch(domain:code.claude.com)",
      "Bash(pnpm *)",
      "Bash(corepack pnpm *)",
      "Bash(./node_modules/.bin/*)",
      "Bash(docker compose up -d)",
      "Bash(docker compose up -d dynamodb-local)",
      "Bash(docker compose down)",
      "Bash(docker compose ps)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose -f .devcontainer/docker-compose.yml up -d dynamodb-local)",
      "Bash(docker compose -f .devcontainer/docker-compose.yml ps*)",
      "Bash(docker compose -f .devcontainer/docker-compose.yml logs *)",
      "Bash(docker ps*)",
      "Bash(docker info*)",
      "Bash(docker version*)",
      "Bash(git *)",
      "Bash(gitleaks *)",
      "Bash(aws sts get-caller-identity *)",
      "Bash(aws sso login *)",
      "Bash(aws dynamodb list-tables --endpoint-url http://localhost:8000*)",
      "Bash(aws dynamodb describe-table * --endpoint-url http://localhost:8000*)",
      "Bash(aws dynamodb scan * --endpoint-url http://localhost:8000*)",
      "Bash(aws dynamodb query * --endpoint-url http://localhost:8000*)",
      "Bash(aws dynamodb get-item * --endpoint-url http://localhost:8000*)",
      "Bash(aws cloudformation describe-* *)",
      "Bash(aws cloudformation list-* *)",
      "Bash(aws cloudformation validate-template *)",
      "Bash(aws iam list-* *)",
      "Bash(aws iam get-* *)",
      "Bash(aws bedrock list-* *)",
      "Bash(aws bedrock get-* *)",
      "Bash(cd *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find . *)",
      "Bash(find /workspace *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(where *)",
      "Bash(type *)",
      "Bash(env)",
      "Bash(printenv *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(wc *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(xargs *)",
      "Bash(tee *)",
      "Bash(diff *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(chmod *)",
      "Bash(date *)",
      "Bash(stat *)",
      "Bash(test *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(realpath *)",
      "Bash(lsof -i *)",
      "Bash(jq *)",
      "Bash(node *)",
      "Bash(npx *)",
      "Bash(gh *)",
      "Bash(sam build*)",
      "Bash(sam local *)",
      "Bash(sam logs *)",
      "Bash(sam validate*)",
      "Bash(shellcheck *)",
      "Bash(curl *)",
      "Bash(ps *)",
      "Bash(kill *)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr ready*)",
      "Bash(docker compose down -v*)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.husky/**)",
      "Edit(/.gitleaks.toml)",
      "Bash(gh api *)",
      "Bash(git clean*)",
      "Bash(git checkout -- *)",
      "Bash(git restore*)",
      "Bash(git stash drop*)",
      "Bash(git branch -D*)",
      "Bash(sed -i*)",
      "Bash(sam deploy*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(git commit --no-verify*)",
      "Bash(git push --no-verify*)",
      "Bash(aws * delete-*)",
      "Bash(aws dynamodb delete-table*)",
      "Bash(aws cloudformation delete-stack*)",
      "Bash(sam delete*)",
      "Bash(gh repo delete*)",
      "Bash(gh release delete*)",
      "Bash(gh secret *)",
      "Bash(find * -delete*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/server-only-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/prettier-on-edit.sh"
          }
        ]
      }
    ]
  },
  "enableAllProjectMcpServers": true
}
