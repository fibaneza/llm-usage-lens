# Dashboard environment template. Copy to .env.local and fill in real values.
# All variables are validated at build time by @t3-oss/env-nextjs (apps/dashboard/env.ts).
# See docs/specs/2026-05-15-implementation-phases.md §Required Environment Variables
# and docs/guides/auth-setup.md.

# --- Auth.js (NextAuth v5) ---
AUTH_SECRET=                 # generate with: npx auth secret
AUTH_URL=http://localhost:3000

# --- Microsoft Entra ID (Auth.js provider) ---
# Optional locally, required in production. Set all three or none.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Issuer: https://login.microsoftonline.com/<Directory (tenant) ID, lowercase GUID>/v2.0 (no trailing slash); common, organizations and consumers are rejected.
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# --- Dev-only local login ---
AUTH_DEV_LOGIN=              # set to "true" for a no-password local sign-in; dev only, rejected in production

# --- AWS / DynamoDB ---
AWS_REGION=us-east-1
AWS_PROFILE=                 # AWS SSO profile; run `aws sso login` first. Omit for DynamoDB Local.
DYNAMODB_TABLE_NAME=bedrock-usage
DYNAMODB_ENDPOINT=http://localhost:8000   # DynamoDB Local; omit for real AWS

# --- OpenTelemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # devcontainer Collector
OTEL_SERVICE_NAME=bedrock-cost-dashboard

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ORG_NAME=Organization   # shown in the top bar

# --- Next.js telemetry ---
NEXT_TELEMETRY_DISABLED=1   # opt out of anonymous Next.js usage data collection
