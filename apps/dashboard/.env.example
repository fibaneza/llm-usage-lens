# Dashboard environment template. Copy to .env: it runs `pnpm dev` as-is with the
# no-password local sign-in (no Entra tenant, no secrets to fill in).
# All variables are validated by @t3-oss/env-nextjs (apps/dashboard/env.ts).
# See docs/specs/2026-05-15-implementation-phases.md §Environment Configuration
# and docs/guides/auth-setup.md.
#
# Files, highest precedence first (all gitignored except this template):
#   .env.local        personal overrides and secrets
#   .env.dev          loaded when APP_ENV=dev
#   .env.prod         loaded when APP_ENV=prod (Entra ID, real AUTH_SECRET)
#   .env              shared defaults; APP_ENV here selects .env.dev or .env.prod
# Restart `pnpm dev` after editing .env.dev or .env.prod.

# --- Environment and access (Access Control spec — Environment) ---
APP_ENV=dev                  # dev | prod (required); prod forbids open mode and requires Entra
AUTH_ACCESS_MODE=            # open | enforce; unset = enforce; open is rejected when APP_ENV=prod

# --- Auth.js (NextAuth v5) ---
# Local placeholder, not a secret: rejected when APP_ENV=prod or in a production
# build. Generate a real one with: npx auth secret
AUTH_SECRET=local-dev-placeholder
AUTH_URL=http://localhost:3000

# --- Dev-only local login ---
# No-password local sign-in; rejected in production and when Entra is configured.
AUTH_DEV_LOGIN=true

# --- Microsoft Entra ID (Auth.js provider) ---
# Optional locally, required when APP_ENV=prod. Set all three or none, and
# remove AUTH_DEV_LOGIN when you set them.
# AUTH_MICROSOFT_ENTRA_ID_ID=
# AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Issuer: https://login.microsoftonline.com/<Directory (tenant) ID, lowercase GUID>/v2.0 (no trailing slash); common, organizations and consumers are rejected.
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# --- Master user (break-glass; optional) ---
# AUTH_MASTER_USERNAME=
# AUTH_MASTER_PASSWORD_HASH=   # Argon2id hash ($argon2id$...); never a plaintext password
# AUTH_MASTER_TOTP_SECRET=     # base32; required when APP_ENV=prod

# --- AWS / DynamoDB ---
AWS_REGION=ap-southeast-2
AWS_PROFILE=                 # AWS SSO profile; run `aws sso login` first. Omit for DynamoDB Local.
DYNAMODB_TABLE_NAME=bedrock-usage
DYNAMODB_ENDPOINT=http://localhost:8000   # DynamoDB Local; omit for real AWS

# --- Audit log (optional) ---
# AUDIT_LOG_GROUP_NAME=        # CloudWatch log group for the audit copy; unset skips delivery

# --- LiteLLM (optional; LiteLLM spec — Security architecture, LD17) ---
# Hosts (host or host:port) the base URL may point at. The service key is the
# Management key for local dev, set in .env.local only; empty = not configured.
LITELLM_ALLOWED_HOSTS=localhost:4000
LITELLM_SERVICE_KEY=

# --- OpenTelemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # devcontainer Collector
OTEL_SERVICE_NAME=llm-usage-lens

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional URL prefix, fixed at build time (Platform spec - Base path). Empty
# serves from /. A value is lower-case /segments with no trailing slash, for
# example /llm-lens; then NEXT_PUBLIC_APP_URL carries it too, while AUTH_URL
# stays origin-only.
NEXT_PUBLIC_BASE_PATH=
# DEPRECATED: set display.orgName in config/config.yaml (the file wins; this
# variable stays a fallback for one release). Shown in the top bar.
NEXT_PUBLIC_ORG_NAME=Organization

# --- App config file (optional; System Architecture — Configuration file) ---
# Path to a mounted config.yaml. Unset (or empty) = the baked-in
# apps/dashboard/config/config.yaml. A missing or invalid file stops the start.
# APP_CONFIG_FILE=

# --- Next.js telemetry ---
NEXT_TELEMETRY_DISABLED=1   # opt out of anonymous Next.js usage data collection
