# Configuration for poc/scripts/deploy-stack.sh.
#
#   cp poc/stack.env.example poc/stack.env
#
# poc/stack.env is gitignored: it holds your account's IDs and ARNs, so never
# commit it. It holds no secrets; application secrets go in .env on the
# instance (poc/.env.example).
#
# Format: KEY=VALUE, one per line. The file is parsed, never executed.
# - Replace each <placeholder> you need; the script refuses a value that still
#   contains "<" or ">".
# - Leave a value empty (or delete the line) to use the template default, or
#   the stack's current value on an update.
# - An option on the command line overrides the value here, for example
#   `deploy-stack.sh --instance-type t4g.medium`.

# --- AWS CLI ---
# Profile and region. Empty: AWS_PROFILE / AWS_REGION from the environment.
AWS_PROFILE=<aws-cli-profile>
AWS_REGION=ap-southeast-2
STACK_NAME=llm-usage-lens-poc

# --- Existing network (required on the first deploy) ---
VpcId=<vpc-id>
SubnetId=<subnet-id>

# --- EC2 instance ---
InstanceName=llm-usage-lens-poc
InstanceType=t4g.small
# arm64 or x86_64; must match InstanceType.
InstanceArchitecture=arm64
RootVolumeSizeGiB=20

# --- ECR ---
EcrRepositoryName=llm-usage-lens-poc
UntaggedImageRetentionDays=7

# --- S3 artifact bucket (optional) ---
# An existing bucket the instance may read (config.yaml, the Docker Compose
# binary), only under <ArtifactKeyPrefix>/. The stack never creates or changes
# it. Empty: the instance gets no S3 access.
ArtifactBucketName=
ArtifactKeyPrefix=llm-usage-lens-poc
# Docker Compose release the instance installs when Amazon Linux has no
# Compose plugin package: first from the bucket, then from GitHub.
ComposeVersion=v2.32.4

# --- Application access ---
AppPort=3000
# Optional trusted IPv4 CIDR for direct access to the instance. Empty: no
# inbound rule (use SSM port forwarding or the load balancer).
AllowedInboundCidr=

# --- Existing Application Load Balancer (optional) ---
# Leave these empty to deploy without a load balancer. Two modes, never both:
#
# Listener mode - the stack adds its own listener (own port) to the load
# balancer: set ExistingAlbArn, AlbListenerPort and (HTTPS) AlbCertificateArn.
#
# Rule mode - the stack adds one rule to a listener another application
# already uses (for example HTTPS 443): set ExistingAlbArn,
# ExistingAlbListenerArn, AlbRulePriority and BasePath, and leave
# AlbListenerPort and AlbCertificateArn empty.
ExistingAlbArn=
# Listener mode only. Empty: the template default.
AlbListenerPort=
# Listener mode only. ACM certificate ARN for an HTTPS listener. Empty: HTTP.
AlbCertificateArn=
# Listener mode only. IPv4 CIDR allowed on the listener port by the POC's new
# security group.
AlbAllowedInboundCidr=
# Rule mode only. ARN of the existing listener that receives the rule.
ExistingAlbListenerArn=
# Rule mode only. 1 to 50000, unused on that listener.
AlbRulePriority=

# --- Base path ---
# The prefix the image was built with (poc/scripts/build-and-push.sh
# --base-path, default /llm-lens). Lower-case /segments, no trailing slash.
# Required in rule mode; the health check path becomes <BasePath>/api/health.
BasePath=/llm-lens
