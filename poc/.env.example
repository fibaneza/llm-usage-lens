# POC runtime environment. On EC2: cp .env.example .env, fill in the values,
# chmod 600 .env. Never commit .env (gitignored) and never put real secrets in
# this template.
#
# Docker Compose reads this file twice: for the ${...} values in
# docker-compose.yml and, through env_file, as the app's environment. The app
# validates its variables at start (apps/dashboard/env.ts) and exits when one
# is missing or invalid, naming the variable.
#
# Quote any value that contains a "$" with SINGLE quotes, or Compose will try
# to interpolate it.

# --- Image (Compose only) ---
# Stack output EcrRepositoryUri: <account>.dkr.ecr.<region>.amazonaws.com/<name>
ECR_REPOSITORY_URI=000000000000.dkr.ecr.ap-southeast-2.amazonaws.com/llm-usage-lens-poc
IMAGE_TAG=latest

# --- Host port binding (Compose only) ---
# Default: loopback, reached through SSM port forwarding (no inbound rule).
# Set APP_BIND_ADDRESS=0.0.0.0 only when the stack was deployed with
# AllowedInboundCidr or ExistingAlbArn; APP_PORT must then equal the stack's
# AppPort.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000

# --- App environment ---
# dev: no KMS key and no Entra requirement, and an http LiteLLM URL is allowed.
APP_ENV=dev

# --- Auth.js ---
# Generate on the instance: openssl rand -base64 33
# The app rejects the repository's local placeholder value in this image.
AUTH_SECRET=
# The URL the browser uses. http://localhost:3000 matches SSM port forwarding
# to local port 3000; change both when you browse another address (for
# example the existing load balancer's https://hostname).
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ORG_NAME=Organization

# --- Sign-in ---
# The image runs with NODE_ENV=production, so the dev login is not available:
# configure the master user (below) or Microsoft Entra ID.
# Hash: see README - Configure the application. Keep the single quotes.
AUTH_MASTER_USERNAME=
AUTH_MASTER_PASSWORD_HASH=''
# Optional outside APP_ENV=prod; when set, a TOTP code is always required.
# AUTH_MASTER_TOTP_SECRET=

# Microsoft Entra ID (optional; set all three or none).
# AUTH_MICROSOFT_ENTRA_ID_ID=
# AUTH_MICROSOFT_ENTRA_ID_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-guid>/v2.0

# --- DynamoDB (DynamoDB Local in this POC) ---
# DYNAMODB_ENDPOINT is fixed in docker-compose.yml (http://dynamodb-local:8000).
AWS_REGION=ap-southeast-2
DYNAMODB_TABLE_NAME=bedrock-usage

# --- External LiteLLM (not part of this POC's Compose stack) ---
# Host or host:port the base URL may point at (comma-separated). The base URL
# itself is entered in the dashboard: Settings -> LiteLLM.
LITELLM_ALLOWED_HOSTS=litellm.example.internal:4000
# LiteLLM service key (docs/guides/litellm-admin.md). Leave empty to run
# without LiteLLM.
LITELLM_SERVICE_KEY=

# --- Telemetry ---
OTEL_SERVICE_NAME=llm-usage-lens-poc
NEXT_TELEMETRY_DISABLED=1
